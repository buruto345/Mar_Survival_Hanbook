    {
      "name": "Create practice article",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/admin/human-survival/articles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "human-survival",
            "articles"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categorySlug\": \"teamwork\",\n  \"slug\": \"{{draftSlug}}\",\n  \"title\": \"What does “filter work complete” mean?\",\n  \"summary\": \"Write a handover that lets the next shift identify an open check.\",\n  \"sections\": [\n    {\n      \"anchor\": \"scenario\",\n      \"heading\": \"Fictional scenario\",\n      \"body\": \"Rin replaced the filter on loop B. The follow-up check is still open. Jo is taking over. The shift log reads “Filter work complete.”\"\n    },\n    {\n      \"anchor\": \"question\",\n      \"heading\": \"Your turn\",\n      \"body\": \"Write the next log entry in your own words. Can Jo tell what happened, what remains open and who owns it?\"\n    },\n    {\n      \"anchor\": \"explanation\",\n      \"heading\": \"One possible response\",\n      \"body\": \"“Loop B filter replaced by Rin. Follow-up check pending. Jo, please take ownership and enter the result in the shift log.” Ask Jo to acknowledge the handover. If Jo is unavailable, the outgoing shift still needs a named recipient.\"\n    },\n    {\n      \"anchor\": \"evidence-limits\",\n      \"heading\": \"Evidence and limits\",\n      \"body\": \"NASA’s team evidence review identifies crew coordination and communication as factors in team performance during exploration missions. The exchange is fictional. The review does not test this wording or establish a filter inspection procedure.\"\n    }\n  ],\n  \"claims\": [\n    {\n      \"key\": \"evidence-limits\",\n      \"text\": \"NASA’s team evidence review identifies crew coordination and communication as factors in team performance during exploration missions.\",\n      \"evidenceType\": \"Observed\",\n      \"testEnvironment\": \"EarthAnalog\",\n      \"sourceRevisionIds\": [\n        \"{{sourceRevisionId}}\"\n      ],\n      \"locator\": {\n        \"section\": \"2022 Team Evidence Report, IV. Executive Summary\"\n      }\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "if (pm.response.code < 300) {",
              "const a = pm.response.json(); pm.collectionVariables.set('articleId', a.id); pm.collectionVariables.set('versionId', a.currentDraftVersionId);",
              "pm.collectionVariables.set('articleETag', pm.response.headers.get('ETag'));",
              "}"
            ]
          }
        }
      ]
    },
