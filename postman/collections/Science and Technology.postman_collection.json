        "body": {
          "mode": "raw",
          "raw": "{\n  \"categorySlug\": \"water-recycling-systems\",\n  \"slug\": \"{{slug}}\",\n  \"title\": \"ISS Water Recovery System\",\n  \"summary\": \"The combined assemblies recover water from multiple waste streams on the space station.\",\n  \"sections\": [\n    {\n      \"anchor\": \"problem\",\n      \"heading\": \"Problem\",\n      \"body\": \"Carrying fresh water for every use makes a crew dependent on resupply.\"\n    },\n    {\n      \"anchor\": \"principle\",\n      \"heading\": \"Principle\",\n      \"body\": \"The urine processor distils wastewater. A brine processor draws more water from the residue into humid air; the station collects condensate and the water processor treats it.\"\n    }\n  ],\n  \"claims\": [\n    {\n      \"key\": \"process\",\n      \"text\": \"The urine processor distils wastewater. A brine processor draws more water from the residue into humid air; the station collects condensate and the water processor treats it.\",\n      \"testEnvironment\": \"InternationalSpaceStation\",\n      \"evidenceType\": \"Tested\",\n      \"sourceRevisionIds\": [\n        \"{{sourceRevisionId}}\"\n      ],\n      \"locator\": {\n        \"section\": \"Discussion of the Urine Processor Assembly, Brine Processor Assembly and Water Processor Assembly\"\n      }\n    }\n  ],\n  \"technologyProfile\": {\n    \"technologyId\": \"{{technologyId}}\",\n    \"technologyStatus\": \"Demonstrated\",\n    \"testEnvironment\": \"InternationalSpaceStation\",\n    \"evidenceType\": \"Tested\",\n    \"capabilities\": \"The combined assemblies recover water from multiple waste streams on the space station.\",\n    \"limitations\": \"The demonstration used the station air and water loops. It does not establish how a stand-alone Mars habitat would perform.\",\n    \"sourceRevisionIds\": [\n      \"{{sourceRevisionId}}\"\n    ],\n    \"resources\": [],\n    \"hazards\": []\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "if (pm.response.code < 300) {",
              "const a = pm.response.json(); pm.collectionVariables.set('articleId', a.id); pm.collectionVariables.set('versionId', a.currentDraftVersionId);",
              "pm.collectionVariables.set('articleETag', pm.response.headers.get('ETag'));",
              "}"
            ]
          }
        }
      ]
